# cred-gw policy for this project. Copy to the project layer as cred-gw.env.
# KEY=VALUE per line (compose env_file syntax), # = comment. A service is on
# when its UPSTREAM is set. After changes: rebuild the container (the host names
# also go into the devcontainer's extra_hosts and NO_PROXY).
#
# The certificate must cover every upstream host:
#   bash .devcontainer/modules/cred-gw/make-certs.sh jira.example.com gitlab.example.com

# ── Jira ──────────────────────────────────────────────────────────────────────
# https://<host>[/path], no port (the gateway listens on 443)
# JIRA_GW_UPSTREAM=https://jira.example.com
# Label that marks the project's issues (required with Jira)
# JIRA_GW_LABEL=my-project
# Project keys whose metadata (components, versions, boards) may be read
# JIRA_GW_PROJECTS=PROJ
# 1 enables edit, comment, transition and create (default: read-only)
# JIRA_GW_ALLOW_WRITES=0

# ── GitLab ────────────────────────────────────────────────────────────────────
# GITLAB_GW_UPSTREAM=https://gitlab.example.com
# Project paths the agent may read (fetch, API GET), comma-separated
# GITLAB_GW_READ=group/shared-lib
# Project paths the agent may push to and open merge requests in
# GITLAB_GW_WRITE=group/my-repo
# Pushable refs (default: feature|fix|bugfix|chore|docs|refactor|test branches)
# GITLAB_GW_PUSH_REFS=^refs/heads/(feature|fix)/
# User name for git Basic auth with the token (default oauth2)
# GITLAB_GW_GIT_USER=oauth2

# ── Gateway ───────────────────────────────────────────────────────────────────
# CA bundle for the upstream certificates (company CA), a file in the project layer
# CRED_GW_UPSTREAM_CA=/run/cred-gw/project/upstream-ca.crt
# Subnet of the internal cred-gw network (a.b.c.0/16..28; gateway at a.b.c.10).
# Change it when it collides, e.g. when two projects with cred-gw run at once.
# CRED_GW_SUBNET=172.30.99.0/28
